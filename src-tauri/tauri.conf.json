{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frontal Lobe",
  "version": "0.1.0",
  "identifier": "com.himo.frontallobe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Frontal Lobe",
        "label": "main",
        "width": 1100,
        "height": 600,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": true
      },
      {
        "title": "Frontal Lobe Tray",
        "label": "tray",
        "width": 300,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}